# ===== 运行模式 =====
# 离线演示模式：true=不连真邮箱，用 data/fixtures.json 假数据；false=连真实 IMAP
DEMO_MODE=true
# 发信护栏：true=只生成草稿不真发，必须显式确认才发送
DRY_RUN=true

# ===== LLM 后端 =====
# ollama（本地大模型）| mock（确定性假大脑，断网可用）
# 接真实邮箱验证连通性时，可设 LLM_PROVIDER=mock（无需先装 Ollama 也能跑通 IMAP/SMTP）
LLM_PROVIDER=ollama
# OpenAI 兼容端点：本地 Ollama 可直接用；接云端 DeepSeek/通义时把 LLM_PROVIDER 改为 openai 并填 LLM_API_KEY
LLM_BASE_URL=http://localhost:11434   # 根地址，不要带 /v1（代码自动拼 /v1/chat/completions）
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b

# ===== 真实邮箱（仅 DEMO_MODE=false 时使用，不要用登录密码，用「授权码/应用专用密码」）=====
# QQ 邮箱示例（其他邮箱见 README「接入真实邮箱」一节）：
#   IMAP：imap.qq.com:993 ｜ SMTP：smtp.qq.com:465
#   密码处填「授权码」，不是 QQ 登录密码！先在邮箱设置里开启 IMAP/SMTP 服务并生成授权码。
MAIL_HOST=imap.qq.com
MAIL_PORT=993
MAIL_USER=你的QQ号@qq.com
MAIL_PASS=你的授权码

# SMTP 发信（默认复用上面 IMAP 的账号/授权码；QQ 用 smtp.qq.com:465 SSL）
MAIL_SMTP_HOST=smtp.qq.com
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
# 发信收件人白名单（逗号分隔，如 a@qq.com,b@163.com）；留空=不限制（仅本地测试用，生产务必配置）
SEND_WHITELIST=

# ===== Agent 参数 =====
MAX_STEPS=8
CONCURRENCY=8
OUT_DIR=out
#STATE_DIR=state