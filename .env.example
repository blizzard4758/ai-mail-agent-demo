# ===== 运行模式 =====
# 离线演示模式：true=不连真邮箱，用 data/fixtures.json 假数据；false=连真实 IMAP
DEMO_MODE=true
# 发信护栏：true=只生成草稿不真发，必须显式确认才发送
DRY_RUN=true

# ===== LLM 后端 =====
# ollama | openai | mock
LLM_PROVIDER=ollama
# Ollama 自带 OpenAI 兼容端点，无需改代码即可接 qwen2.5 / llama3 等本地模型
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b

# ===== 真实邮箱（仅 DEMO_MODE=false 时使用，不要用登录密码，用应用专用密码）=====
MAIL_HOST=
MAIL_PORT=993
MAIL_USER=
MAIL_PASS=

# ===== Agent 参数 =====
MAX_STEPS=8
CONCURRENCY=8
OUT_DIR=out
